{
  "name": "dnd-mcp-poc",
  "version": "0.1.0",
  "description": "AI Dungeon Master MCP-first D&D Tabletop - Phase 00 PoC",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "tsx src/index.ts",
    "start:http": "tsx src/index.ts --http",
    "start:remote": "tsx src/index.ts --http --remote",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:client": "tsx scripts/smoke-client.ts",
    "scene:demo": "tsx scripts/scene-demo.ts",
    "db:reset": "tsx scripts/reset-db.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^22.13.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}
